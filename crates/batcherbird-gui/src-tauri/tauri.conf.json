{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Batcherbird",
  "version": "0.1.0",
  "identifier": "com.batcherbird.gui",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Batcherbird",
        "width": 1200,
        "height": 850,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: tauri: asset:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DESKTOP/*",
          "$DOCUMENT/*", 
          "$HOME/Documents/BatcherBird Projects/*",
          "$APPDATA/*",
          "$RESOURCE/*"
        ]
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
